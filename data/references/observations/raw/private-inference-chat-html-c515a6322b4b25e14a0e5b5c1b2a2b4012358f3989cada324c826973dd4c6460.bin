<script>(function(){try{var t=localStorage.getItem("pi.theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t;}catch(e){}})();</script>
<script>(function(){
var left=3;
var send=function(text){if(left<=0)return;left--;
try{fetch("/chat/client-error",{method:"POST",keepalive:true,headers:{"content-type":"application/json"},body:JSON.stringify({where:"page",message:String(text).slice(0,700)+" · "+navigator.userAgent.slice(0,290)})}).catch(function(){});}catch(e){}};
addEventListener("error",function(e){if(!e.message)return;send(e.message+" at "+(e.filename||"?")+":"+e.lineno+":"+e.colno);});
addEventListener("unhandledrejection",function(e){var r=e.reason;send("unhandled: "+(r&&r.stack?String(r.stack).split("\n").slice(0,3).join(" / "):r&&r.message?r.message:String(r)));});
})();</script>
<script>(function(){
var u=new URL(location.href);
if(u.searchParams.has("v")){u.searchParams.delete("v");history.replaceState(history.state,"",u.pathname+u.search+u.hash);}
window.piStale=function(){
if(navigator.onLine===false)return false;
try{var last=Number(sessionStorage.getItem("pi.stale"))||0;if(Date.now()-last<60000)return false;sessionStorage.setItem("pi.stale",String(Date.now()));}catch(e){}
var next=new URL(location.href);next.searchParams.set("v",Date.now().toString(36));location.replace(next.href);return true;};
addEventListener("error",function(e){var t=e.target;if(t&&t.tagName==="SCRIPT"&&t.src&&new URL(t.src,location.href).origin===location.origin&&t.src.indexOf("/chat/js/")>=0)window.piStale();},true);
})();</script>
