<script>
document.addEventListener("click", function (e) {
  var b = e.target.closest && e.target.closest("[data-theme-set]");
  if (!b) return;
  var t = b.getAttribute("data-theme-set");
  document.documentElement.dataset.theme = t;
  try { localStorage.setItem("pi.theme", t); } catch (err) {}
});
</script>
<script>
(function () {
  var parts = function () {
    return { b: document.querySelector("[aria-controls=site-menu]"), m: document.getElementById("site-menu") };
  };
  var setOpen = function (open) {
    var x = parts();
    if (!x.b || !x.m) return;
    x.m.hidden = !open;
    x.b.setAttribute("aria-expanded", String(open));
    x.b.setAttribute("aria-label", open ? "Close menu" : "Menu");
    x.b.querySelector(".pi-menu-open").classList.toggle("hidden", open);
    x.b.querySelector(".pi-menu-close").classList.toggle("hidden", !open);
    document.documentElement.classList.toggle("overflow-hidden", open);
    var acc = document.getElementById("account");
    var home = x.m.querySelector("[data-account-home]");
    var nav = document.querySelector("nav[aria-label=main]");
    if (!acc || !home) return;
    if (open) home.appendChild(acc);
    else if (nav && acc.parentElement !== nav.parentElement) nav.parentElement.appendChild(acc);
  };
  document.addEventListener("click", function (e) {
    var t = e.target;
    if (!t || !t.closest) return;
    if (t.closest("[aria-controls=site-menu]")) { var x = parts(); setOpen(Boolean(x.m && x.m.hidden)); return; }
    if (t.closest("#site-menu a") || t.closest("[data-account-home] button:not([aria-haspopup])")) setTimeout(function () { setOpen(false); }, 0);
  });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") setOpen(false); });
  var wide = window.matchMedia("(min-width: 40rem)");
  if (wide.addEventListener) wide.addEventListener("change", function (m) { if (m.matches) setOpen(false); });
})();
</script>
<script>
(function () {
  var cache = new Map();
  // The page on screen; a history move that stays on it (a #hash) is the browser's own scroll.
  var shown = location.pathname + location.search;
  var internal = function (a) {
    return a && a.href && a.origin === location.origin && !a.hasAttribute("download") && !a.target &&
      a.getAttribute("href") && a.getAttribute("href").charAt(0) === "/" && !new RegExp("^/(health|admin|v1|og[.]png)").test(a.pathname);
  };
  // Pages seen or prefetched stay in memory: shown at once, and refreshed behind the scenes each
  // time one is shown, so a new build or setting reaches the next visit. A hover only fills a gap.
  var pages = new Map();
  var fetchPage = function (url) {
    if (!cache.has(url)) {
      cache.set(url, fetch(url, { headers: { "x-pi-navigate": "1" } })
        .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
        .then(function (html) { pages.set(url, html); return html; })
        .finally(function () { cache.delete(url); }));
    }
    return cache.get(url);
  };
  var load = function (url, showing) {
    var kept = pages.get(url);
    if (!kept) return fetchPage(url);
    if (showing) fetchPage(url).catch(function () {});
    return Promise.resolve(kept);
  };
  // hash: a part of the new page the link points at (/how-it-works#api), scrolled to once it is in.
  var swap = function (html, url, push, hash) {
    var doc = new DOMParser().parseFromString(html, "text/html");
    var next = doc.getElementById("app");
    if (!next) { location.href = url; return; }
    var app = document.getElementById("app");
    app.replaceWith(next);
    if (window.piRefCode) window.piRefCode();
    document.title = next.dataset.title || document.title;
    next.querySelectorAll("script").forEach(function (old) {
      var s = document.createElement("script");
      Array.prototype.forEach.call(old.attributes, function (a) { s.setAttribute(a.name, a.value); });
      s.textContent = old.textContent;
      old.replaceWith(s);
    });
    if (push) history.pushState({ pi: url }, "", url + (hash || ""));
    shown = url;
    var part = push ? hash : location.hash;
    var target = part && document.getElementById(decodeURIComponent(part.slice(1)));
    if (target) target.scrollIntoView();
    else window.scrollTo(0, 0);
  };
  document.addEventListener("click", function (e) {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    var a = e.target.closest && e.target.closest("a");
    if (!internal(a)) return;
    var url = a.pathname + a.search;
    if (url === location.pathname + location.search && !a.hash) { e.preventDefault(); return; }
    if (a.hash && a.pathname === location.pathname) return;
    e.preventDefault();
    load(url, true).then(function (html) { swap(html, url, true, a.hash); }).catch(function () { location.href = url + a.hash; });
  });
  document.addEventListener("mouseover", function (e) {
    var a = e.target.closest && e.target.closest("a");
    if (internal(a) && a.pathname !== location.pathname) load(a.pathname + a.search).catch(function () {});
  });
  window.addEventListener("popstate", function () {
    var url = location.pathname + location.search;
    if (url === shown) return;
    load(url, true).then(function (html) { swap(html, url, false); }).catch(function () { location.reload(); });
  });
  history.replaceState({ pi: location.pathname }, "", location.href);
  // The menu's pages, fetched while the browser is idle, so the first click is instant too.
  var idle = window.requestIdleCallback || function (f) { return setTimeout(f, 1500); };
  idle(function () {
    document.querySelectorAll("header a").forEach(function (a) {
      if (internal(a) && a.pathname + a.search !== shown) load(a.pathname + a.search).catch(function () {});
    });
  });
})();
</script>
<script>
(function () {
  var known = null;
  var show = function (s) {
    document.querySelectorAll("[data-ref-code]").forEach(function (box) {
      box.hidden = !s;
      box.querySelector("[data-ref-value]").textContent = s ? s.code : "";
      box.setAttribute("data-link", s ? s.link : "");
    });
  };
  var refresh = function () {
    var key = null;
    try { key = localStorage.getItem("pi.apiKey"); } catch (e) {}
    if (!key) { known = null; show(null); return; }
    if (known && known.key === key) { show(known.stats); return; }
    show(null);
    fetch("/v1/referrals", { headers: { authorization: "Bearer " + key } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (s) {
        if (!s || typeof s.code !== "string" || typeof s.link !== "string") return;
        known = { key: key, stats: { code: s.code, link: s.link } };
        show(known.stats);
      })
      .catch(function () {});
  };
  document.addEventListener("click", function (e) {
    var b = e.target.closest && e.target.closest("[data-ref-copy]");
    if (!b) return;
    var link = b.closest("[data-ref-code]").getAttribute("data-link");
    if (!link || !navigator.clipboard) return;
    navigator.clipboard.writeText(link).then(function () {
      b.setAttribute("aria-label", "Copied");
      b.setAttribute("title", "Copied");
      setTimeout(function () {
        b.setAttribute("aria-label", "Copy your invite link");
        b.setAttribute("title", "Copy your invite link");
      }, 1500);
    }).catch(function () {});
  });
  window.piRefCode = refresh;
  refresh();
})();
</script>
</body>
</html>
