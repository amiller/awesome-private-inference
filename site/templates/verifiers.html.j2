{% extends "_base.html.j2" %}
{% block title %}Curated verifiers · Private Inference Beat{% endblock %}
{% block content %}
<h1 class="text-2xl font-bold">Curated private inference verifiers</h1>
<p class="mt-2 text-slate-600">Find implementations, their reference policies and the proof they leave unfinished. Inclusion is useful even when a provider has no live verifier in this repository.</p>
<p class="mt-3 text-sm">{{ verifier_catalog.review_scope }} {% if verifier_catalog.source_revision %}Repository evidence is pinned to <code>{{ verifier_catalog.source_revision[:12] }}</code>; upstream leads retain their listed revision and status.{% endif %} Directory review dates are separate from observation dates and provider audit dates.</p>
<p class="mt-3 text-sm"><a class="underline text-indigo-700" href="./verifiers.json">Directory JSON</a> · <a class="underline text-indigo-700" href="./reference-values.json">Reference observations JSON v1</a> · <a class="underline text-indigo-700" href="{{ repo_url }}specifications/shared-verification.md">Abalone / gateway consumption contract</a></p>
{% for item in verifier_catalog.providers %}
<section id="{{ item.provider }}" class="mt-7 border-t pt-4">
<h2 class="text-xl font-semibold">{{ item.name }}</h2>
<p class="text-xs text-slate-500 mt-1">Directory reviewed {{ item.reviewed_at }} · {{ item.route_ids|length }} paths · <a class="underline" href="./history.html?provider={{ item.provider }}">Dated reference history</a></p>
<ul class="mt-3 list-disc pl-5 text-sm space-y-2">{% for impl in item.implementations %}<li><a class="underline text-indigo-700 break-all" href="{{ impl.source_url }}">{{ impl.source }}</a> — {{ impl.status }}{% if impl.entrypoint %}<br><code class="break-all whitespace-normal">{{ impl.entrypoint }}</code>{% endif %}</li>{% endfor %}</ul>
<dl class="mt-3 text-sm space-y-2">
<div><dt class="font-semibold">Checks / evidence available</dt><dd>{{ item.checks|join(' ') }}</dd></div>
<div><dt class="font-semibold">Delegated trust and policy</dt><dd>{{ item.delegates|join(' ') }}</dd></div>
<div><dt class="font-semibold">Unchecked or missing</dt><dd>{{ item.unchecked|join(' ') }}</dd></div>
</dl>
<p class="mt-3 text-sm">Routes: {% for route in item.route_ids %}<a class="underline text-indigo-700 mr-3" href="./evidence.html#route-{{ route }}">{{ route }}</a>{% endfor %}</p>
<p class="mt-2 text-xs">Scope evidence: {% for source in item.evidence_linked %}<a class="inline-block max-w-full break-all underline text-indigo-700 mr-3" href="{{ source.url }}">{{ source.label }}</a> {% endfor %}</p>
</section>{% endfor %}
{% endblock %}
