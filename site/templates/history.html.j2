<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Reference history · Private Inference Beat</title>
<style>
:root{color-scheme:light;--ink:#172b3c;--muted:#546779;--line:#dce5eb;--violet:#7154cb;--blue:#16869b;--amber:#b16d0b}*{box-sizing:border-box}body{margin:0;background:#f5f7fa;color:var(--ink);font:15px/1.5 system-ui,sans-serif}main{max-width:1440px;margin:auto;padding:32px}a{color:#3855ad}header{display:flex;justify-content:space-between;gap:24px;align-items:center}h1{font-size:36px;letter-spacing:-1.2px;margin:12px 0}h2{font-size:21px;margin:0 0 12px}p{margin:8px 0}.eyebrow{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--muted)}.intro{max-width:850px;color:var(--muted);font-size:17px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:26px 0}.stat,.card{min-width:0;background:white;border:1px solid var(--line);border-radius:12px;padding:20px}.stat strong{font-size:28px;display:block}.stat span{color:var(--muted);font-size:13px}.controls{display:flex;gap:14px;flex-wrap:wrap;align-items:end;margin:16px 0}label{font-size:12px;color:var(--muted)}select,input{font:inherit;padding:9px;border:1px solid #afbdc9;border-radius:6px;background:white;color:var(--ink);max-width:100%}label select,label input{display:block;margin-top:4px}.legend{font-size:12px;color:var(--muted);display:flex;gap:18px;flex-wrap:wrap}.legend b{display:inline-block;border-radius:50%;width:9px;height:9px;margin-right:5px}.chart{overflow-x:auto;margin-top:15px}svg{display:block;width:100%;min-width:780px}svg text{font-family:system-ui,sans-serif;fill:var(--muted);font-size:11px}svg .mark{cursor:pointer}svg .mark:hover,svg .mark:focus{stroke:#152d46;stroke-width:3;outline:none}.layout>*{min-width:0}.layout{display:grid;grid-template-columns:minmax(0,1fr) 370px;gap:18px;margin-top:18px}.detail{max-height:650px;overflow:auto}.muted,.note{color:var(--muted)}.note{font-size:12px}.tag{display:inline-block;font-size:11px;padding:3px 7px;border-radius:5px;background:#f0ebfc;color:#5941a9;margin:4px 4px 4px 0}.value{font:11px/1.6 ui-monospace,monospace;overflow-wrap:anywhere;margin:3px 0;padding:5px;background:#f5f7fa}.event-list{max-height:280px;overflow:auto;margin:10px 0}.event-button{display:block;text-align:left;width:100%;background:white;border:1px solid var(--line);padding:10px;cursor:pointer;border-radius:6px;margin:5px 0;color:var(--ink)}.event-button:hover{background:#f0ebfc}.inventory{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;vertical-align:top;border-bottom:1px solid var(--line);padding:12px 8px}th{color:var(--muted)}td:first-child{min-width:180px}.table-wrap{overflow:auto}.inventory details{max-width:540px}.inventory summary{cursor:pointer;overflow-wrap:anywhere}button{font:inherit}.small{font-size:12px}.audit{border-left:3px solid #16869b;padding-left:10px}.limits{margin:20px 0;max-width:1000px}.snapshot-gap{fill:#eebd79;opacity:.2}footer{margin:24px 0;color:var(--muted);font-size:12px}@media(max-width:900px){main{padding:18px}.layout{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}h1{font-size:28px}header{display:block}.detail{max-height:none}}
</style></head><body><main>
<header><div class="eyebrow">Private Inference Beat / reference observatory</div><span><a href="./verifiers.html">Verifiers</a> · <a href="./reference-values.json">Reference observations JSON v1</a> · <a href="./index.html">Route dashboard ↗</a></span></header>
<h1>What changed. What it covers.</h1>
<p class="intro">A history of the reference values we actually captured. Follow a measured workload, policy document or reference set from one observation to the next—and see where the code behind a changed value is still unknown.</p>
<div class="stats"><div class="stat"><strong id="stat-tracks"></strong><span>tracked reference surfaces</span></div><div class="stat"><strong id="stat-changes"></strong><span>observed set transitions · excludes baselines</span></div><div class="stat"><strong id="stat-review"></strong><span>full-value ledger review records</span></div><div class="stat"><strong>Unknown</strong><span>deployed code diff size for these transitions</span></div></div>
<section class="card"><h2>Reference change timeline</h2><p class="note">Dots mark first captures, changed sets and returns to previously seen sets. Pale ticks mark sampled days. Empty space means no capture; it does not prove stability. Dates are UTC observation dates.</p>
<div class="controls"><label>Provider<select id="provider"><option value="">All providers</option></select></label><label>Evidence layer<select id="family"><option value="">All layers</option><option>reported workload</option><option>published reference set</option><option>published document</option><option>client policy</option></select></label><label>Circle area represents<select id="size"><option value="entries">Changed reference entries</option><option value="text">Captured text lines changed</option><option value="routes">Provider route cards</option></select></label><label>Track layout<select id="group"><option value="provider">Provider overview</option><option value="component">Individual reference surfaces</option></select></label><label>Search<input id="search" type="search" placeholder="PCR, model, digest, component…"></label></div>
<div class="legend"><span><b style="background:#8d9baa"></b>First capture</span><span><b style="background:#7154cb"></b>New set</span><span><b style="background:#16869b"></b>Revisited set</span><span>○ Size unknown / no comparable prior bytes</span><span>Amber bands: missing daily snapshot</span></div>
<div class="chart" id="chart"></div><p class="note" id="chart-note"></p></section>
<div class="layout"><section class="card"><h2>Latest captured values</h2><p class="note">Full values stay inspectable. “Latest” means the last capture of this surface; it may be historical. Reported workload ≠ published reference ≠ values accepted by a particular client.</p><p id="missing" class="note"></p><div class="table-wrap"><table class="inventory"><thead><tr><th>Surface / evidence</th><th>Last capture</th><th>History</th><th>Full reference values</th></tr></thead><tbody id="inventory"></tbody></table></div></section>
<aside class="card detail" id="details" aria-live="polite"><h2>Inspect a change</h2><p class="muted">Select a timeline circle or reference surface. Its full old/new values, measurement scope and evidence will appear here.</p></aside></div>
<section class="limits"><h2>How to read magnitude</h2><p><strong>Reference-set delta:</strong> the number of entries added and removed. Replacing one opaque hash is two set edits; it says nothing about the size of the underlying code change.</p><p><strong>Captured-text delta:</strong> inserted and deleted lines between retained versions of the same document. A one-line minified bundle can contain a large change. This is not a deployed-code diff.</p><p><strong>Provider route cards:</strong> inventory routes associated with the provider or observed model. This is a conservative navigation aid, not a verified dependency graph or a count of affected plaintext paths.</p><p><strong>Audit surface:</strong> every point links to the precise reference and evidence surface. Full-value matches to the existing review ledger are shown with their recorded scope and review date; they are not new audit approvals. Source-to-artifact mappings, reproducible builds, request bindings, dependency changes and operator policy changes still need a scoped review. No synthetic risk score is assigned.</p><p class="note">The published JSON inventory extracts digest-shaped values with their field paths, including policy keys. It does not interpret every boolean, threshold or permission as a reference value; the document hash still catches those edits. Provider-supplied historical PCR lists are captured as sets at fetch time, not backdated as observed deployments. Legacy model rows and rejected reports remain visible without upgrading their trust.</p></section>
<footer>Derived from repository evidence through {{ history.last }}. {{ history.snapshot_gap_days|length }} missing daily snapshot dates in the stored historical window. <a id="download" download="reference-history.json">Download the plotted data</a>. No network request is needed to use this page offline.</footer>
<script id="history-data" type="application/json">{{ history|tojson }}</script>
<script>
const D=JSON.parse(document.getElementById('history-data').textContent), $=id=>document.getElementById(id), NS='http://www.w3.org/2000/svg', L=new Map(D.lanes.map(l=>[l.id,l])), E=new Map(D.events.map(e=>[e.id,e]));
const colors={'baseline':'#8d9baa','new set':'#7154cb','revisit':'#16869b'}, url=p=>'https://github.com/amiller/awesome-private-inference/blob/main/'+p;
function node(tag,text,cls){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;if(cls)n.className=cls;return n}
function link(text,path){const a=node('a',text);a.href=url(path);a.target='_blank';a.rel='noopener';return a}
function values(parent,title,vs){const d=node('details');d.append(node('summary',`${title} (${vs.length})`));for(const v of vs)d.append(node('div',v,'value'));parent.append(d)}
function inspect(e){const l=L.get(e.lane),p=$('details');p.replaceChildren(node('h2',l.provider),node('div',l.component,'small'),node('span',l.field+' · '+l.family,'tag'),node('p',e.at.slice(0,19).replace('T',' ')+' UTC'));
 p.append(node('p',e.kind==='baseline'?'First retained capture. Earlier state is unknown.':`${e.added.length} entries added · ${e.removed.length} removed · ${e.kind}`),node('p',e.scope,'note'));
 if(e.previous_at)p.append(node('p',`Change first observed between ${e.previous_at.slice(0,19)} and ${e.at.slice(0,19)}. It may have happened earlier than this observation window if sampling switched instances.`,'note'));
 p.append(node('p','Deployed code change size: unknown. No proven source-to-artifact diff is attached.','audit'));
 if(e.text_delta)p.append(node('p',`Captured document: +${e.text_delta.added} / −${e.text_delta.removed} lines. This is a byte-source proxy, not code audit effort.`));
 p.append(node('p',`${l.routes.length} related inventory route cards (not proven affected routes).`,'note'));
 values(p,'Added',e.added);values(p,'Removed',e.removed);values(p,'Full new set',e.new);
 p.append(node('p'));p.append(link('Captured evidence ↗',e.evidence));if(e.previous_evidence){p.append(node('br'));p.append(link('Previous evidence ↗',e.previous_evidence));}
 p.append(node('h3','Recorded review coverage'));
 if(!e.reviews.length)p.append(node('p','No exact full-value match in the imported review ledger. This does not prove nobody reviewed it elsewhere.','note'));
 for(const r of e.reviews){p.append(node('p',`${r.at}: ${r.verdict}`,'audit'),node('p',r.scope,'note'),link('Ledger record ↗',r.evidence));}
}
function bucket(es){if(es.length===1){inspect(es[0]);return}const p=$('details');p.replaceChildren(node('h2',`${es.length} reference events`),node('p',`${es[0].provider} · ${es[0].at.slice(0,10)}`,'note'));const list=node('div',undefined,'event-list');for(const e of es){const l=L.get(e.lane),b=node('button',`${l.component} / ${l.field} — ${e.kind}`,'event-button');b.onclick=()=>inspect(e);list.append(b)}p.append(list,node('p','Several tracks can describe the same underlying change; these are not independent deployments.','note'))}
function svgEl(tag,attrs,text){const n=document.createElementNS(NS,tag);for(const [k,v]of Object.entries(attrs))n.setAttribute(k,v);if(text!==undefined)n.textContent=text;return n}
function magnitude(es){const metric=$('size').value;if(es.every(e=>e.kind==='baseline'))return null;if(metric==='text'){if(es.some(e=>!e.text_delta))return null;return es.reduce((s,e)=>s+e.text_delta.added+e.text_delta.removed,0)}if(metric==='routes')return new Set(es.flatMap(e=>L.get(e.lane).routes)).size;return es.reduce((s,e)=>s+(e.kind==='baseline'?0:e.added.length+e.removed.length),0)}
function render(){const q=$('search').value.toLowerCase();const lanes=D.lanes.filter(l=>(!$('provider').value||l.provider===$('provider').value)&&(!$('family').value||l.family===$('family').value)&&(!q||[l.component,l.field,...l.latest].join(' ').toLowerCase().includes(q))),ids=new Set(lanes.map(l=>l.id)),events=D.events.filter(e=>ids.has(e.lane));const group=$('group').value==='provider'?l=>l.provider:l=>l.id,keys=[...new Set(lanes.map(group))],w=1100,left=240,right=30,row=42,h=Math.max(130,keys.length*row+65);const start=Date.parse(D.first||'2026-01-01'),end=Math.max(start+86400000,Date.parse(D.last||'2026-01-02')),x=t=>left+(Date.parse(t)-start)/(end-start)*(w-left-right),svg=svgEl('svg',{viewBox:`0 0 ${w} ${h}`,role:'img','aria-label':'Reference changes over time. Timeline points can be selected with keyboard or pointer.'});
 for(const day of D.snapshot_gap_days)svg.append(svgEl('rect',{x:x(day),y:28,width:Math.max(2,x(day+'T23:59:59Z')-x(day)),height:h-40,class:'snapshot-gap'}));
 for(let i=0;i<7;i++){const at=new Date(start+(end-start)*i/6).toISOString();svg.append(svgEl('text',{x:x(at),y:17,'text-anchor':'middle'},at.slice(0,10)));svg.append(svgEl('line',{x1:x(at),x2:x(at),y1:26,y2:h-15,stroke:'#e6ecf1'}));}
 keys.forEach((key,i)=>{const ls=lanes.filter(l=>group(l)===key),y=48+i*row,label=$('group').value==='provider'?key:ls[0].component+' / '+ls[0].field;const t=svgEl('text',{x:4,y:y+4},label.length>35?label.slice(0,33)+'…':label);t.append(svgEl('title',{},label));svg.append(t);for(const day of new Set(ls.flatMap(l=>l.sample_days)))svg.append(svgEl('line',{x1:x(day),x2:x(day),y1:y-4,y2:y+4,stroke:'#c6d3dc','stroke-width':2}));const bs=new Map();for(const e of events.filter(e=>ls.some(l=>l.id===e.lane))){const day=e.at.slice(0,10);if(!bs.has(day))bs.set(day,[]);bs.get(day).push(e)}for(const es of bs.values()){const m=magnitude(es),kind=es.some(e=>e.kind==='new set')?'new set':es.some(e=>e.kind==='revisit')?'revisit':'baseline',r=m===null?4:Math.min(15,3+Math.sqrt(m)*1.4),circle=svgEl('circle',{cx:x(es[0].at),cy:y,r,fill:m===null?'white':colors[kind],stroke:colors[kind],'stroke-width':1.8,class:'mark','data-event-ids':es.map(e=>e.id).join(','),tabindex:0,role:'button','aria-label':`${key}, ${es[0].at.slice(0,10)}, ${es.length} events`});circle.append(svgEl('title',{},`${es[0].at.slice(0,10)} · ${es.length} events · ${m===null?'size unknown':m+' '+$('size').selectedOptions[0].text}`));circle.onclick=()=>bucket(es);circle.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();bucket(es)}};svg.append(circle)}});
 $('chart').replaceChildren(svg);$('chart-note').textContent=`${lanes.length} surfaces shown. Bubble area scales approximately with the selected count and is capped for readability; exact counts are available on selection. Baselines have no change magnitude.`;
 const body=$('inventory');body.replaceChildren();for(const l of lanes){const tr=node('tr'),a=node('td'),b=node('td',l.last.slice(0,10)),c=node('td',`${l.changes} changes / ${l.samples} captures`),d=node('td');a.append(node('strong',l.provider),node('div',l.component),node('span',l.field+' · '+l.family,'tag'));a.append(link('Evidence ↗',l.evidence));values(d,`${l.latest.length} latest entries`,l.latest);const btn=node('button','Inspect latest event','event-button');btn.onclick=()=>inspect(E.get(l.events.at(-1)));a.append(btn);tr.append(a,b,c,d);body.append(tr)}
 const absent=D.inventory_providers.filter(p=>!D.lanes.some(l=>l.provider===p));$('missing').textContent=absent.length?'Inventory providers without extracted reference values: '+absent.join(', ')+'. Absence is a coverage gap.':'';
}
for(const p of [...new Set([...D.inventory_providers,...D.lanes.map(l=>l.provider)])].sort()){$('provider').append(node('option',p));$('provider').lastChild.value=p}
$('stat-tracks').textContent=D.lanes.length;$('stat-changes').textContent=D.events.filter(e=>e.kind!=='baseline').length;$('stat-review').textContent=D.reviews.length;
for(const id of ['provider','family','size','group','search'])$(id).addEventListener(id==='search'?'input':'change',render);
const requestedProvider=new URLSearchParams(location.search).get('provider');if([...$('provider').options].some(o=>o.value===requestedProvider))$('provider').value=requestedProvider;
$('download').href=URL.createObjectURL(new Blob([JSON.stringify(D,null,2)],{type:'application/json'}));render();
</script></main></body></html>
