{% extends "_base.html.j2" %}
{% block content %}
{% include "_assessment_style.html.j2" %}
{% macro badge(state, href, title) %}<a class="signal {{ state }}" href="{{ href }}" title="{{ title }}">{{ assessment_states[state][1] }} {{ assessment_states[state][0] }}</a>{% endmacro %}
<section class="mb-4">
  <h1 class="text-2xl font-bold tracking-tight">Private Inference Beat</h1>
  <p class="mt-1 text-sm text-slate-600">Compare what clients can verify and what operators can change. Expand a provider for its request paths.</p>
  <p class="mt-2 text-xs text-slate-500"><a href="./verifiers.html" class="text-indigo-700 underline">Curated verifiers</a> · <a href="./history.html" class="text-indigo-700 underline">Reference-value transparency</a> · <a href="./stages.html" class="text-indigo-700 underline">Stage criteria (proposed)</a> · Dated assessments; no stages awarded</p>
</section>
<div class="mb-3 flex flex-wrap items-center gap-4 text-xs text-slate-600">
  <label>Provider <select id="provider-filter" class="border rounded bg-white px-2 py-1"><option value="">All</option>{% for group in assessment_groups %}<option value="{{ group.id }}">{{ group.name }}</option>{% endfor %}</select></label>
  <button id="expand-all" class="underline text-indigo-700" type="button">Expand all routes</button>
  <span>◐ partial evidence · × documented gap · ? unknown · ↕ routes differ</span>
</div>
<p class="mb-2 text-xs text-slate-500 lg:hidden">Scroll sideways; provider names stay visible.</p>
<div class="assessment-scroll">
<table class="assessment-table">
  <thead><tr><th scope="col">Provider / path</th>{% for key, axis in assessment_axes.items() %}<th scope="col"><a href="./assessments.html#rubric-{{ key }}" title="{{ axis[1] }}">{{ axis[0] }}</a></th>{% endfor %}<th scope="col" title="Evidence returned does not mean verification passed.">Collection</th><th scope="col" title="Latest newly observed reference set anywhere in this provider's tracked surfaces; not deployment time.">New reference</th><th scope="col">Review</th></tr></thead>
  {% for group in assessment_groups %}
  <tbody data-provider="{{ group.id }}">
    <tr class="provider-row">
      <td><button type="button" class="provider-toggle" aria-expanded="false" aria-controls="routes-{{ group.id }}"><span class="chevron" aria-hidden="true">›</span>{{ group.name }}</button> <span class="provider-meta">{{ group.routes|length }} {{ 'path' if group.routes|length == 1 else 'paths' }}</span></td>
      {% for key, cell in group.axes.items() %}<td>{{ badge(cell.state, './assessments.html#provider-' ~ group.id ~ '-' ~ key, group.name ~ ': ' ~ assessment_axes[key][1] ~ ' ' ~ assessment_states[cell.state][0] ~ '. Open route-specific reasons and sources.') }}</td>{% endfor %}
      <td class="collection" title="{{ group.observations|length }} distinct model/endpoint observations. Collection status is separate from proof or audit status.">{{ group.collection }}</td>
      <td><a class="history-link" href="{{ group.history_url }}">{{ group.last_new[5:10] if group.last_new else ('Baseline' if group.baseline_only else 'No history') }}</a>{% if group.changed_surfaces %}<span class="needs-review">{{ group.changed_surfaces }} changed since review</span>{% endif %}{% if group.missing_surfaces %}<span class="needs-review">Coverage missing</span>{% endif %}</td>
      <td><a class="detail-link" href="./assessments.html#provider-{{ group.id }}">{{ group.reviewed_at[5:] if group.reviewed_at != 'Unreviewed' else 'Unreviewed' }}</a></td>
    </tr>
  </tbody>
  <tbody id="routes-{{ group.id }}" data-provider="{{ group.id }}" class="route-body" hidden>
    {% for route in group.routes %}<tr class="route-row">
      <td><a href="./assessments.html#route-{{ route.id }}" class="detail-link" title="{{ route.architecture|default(route.protocol) }}">{{ route.label }}</a></td>
      {% for key, cell in route.axes.items() %}<td>{{ badge(cell.state, './assessments.html#' ~ route.id ~ '-' ~ key, cell.reason) }}</td>{% endfor %}
      <td class="collection">{{ route.collection }}</td><td colspan="2"><a class="detail-link" href="./evidence.html#route-{{ route.id }}">Source &amp; probe details</a></td>
    </tr>{% endfor %}
  </tbody>
  {% endfor %}
</table>
</div>
<p class="mt-3 text-xs text-slate-500">{{ assessment_groups|length }} providers · {{ route_cards|length }} paths · Dates refer to source review. “Gap” identifies a documented client/protocol protection gap, not a demonstrated compromise. Missing checks in our tool remain Unknown. Collection counts do not measure privacy.</p>
<p class="mt-2 text-xs text-slate-500">Reference dates are provider-wide first sightings of new sets. Later reference differences flag review work; they never authorize a new value. <a href="./history.html" class="text-indigo-700 underline">Explore reference history →</a></p>
<p class="mt-3 text-sm"><a href="./measurements.html" class="text-indigo-700 underline">All {{ rows|length }} model / endpoint measurements →</a></p>
<noscript><style>.route-body[hidden]{display:table-row-group!important}</style><p>All routes are shown because JavaScript is disabled.</p></noscript>
<script>
const toggles=[...document.querySelectorAll('.provider-toggle')];
function toggle(b,expanded){b.setAttribute('aria-expanded',String(expanded));document.getElementById(b.getAttribute('aria-controls')).hidden=!expanded;}
for(const b of toggles)b.onclick=()=>toggle(b,b.getAttribute('aria-expanded')!=='true');
document.getElementById('expand-all').onclick=function(){const expanded=toggles.some(b=>b.getAttribute('aria-expanded')!=='true');toggles.forEach(b=>toggle(b,expanded));this.textContent=expanded?'Collapse all routes':'Expand all routes'};
document.getElementById('provider-filter').onchange=function(){for(const body of document.querySelectorAll('tbody[data-provider]'))body.style.display=this.value&&body.dataset.provider!==this.value?'none':''};
</script>
{% endblock %}
