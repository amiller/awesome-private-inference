{% extends "_base.html.j2" %}
{% block content %}
<style>
  .matrix { width:100%; border-collapse:collapse; font-size:12px; }
  .matrix th { padding:10px 7px; text-align:center; background:#f1f5f9; color:#475569; font-weight:600; }
  .matrix td { padding:9px 7px; border-top:1px solid #e2e8f0; text-align:center; }
  .matrix th:first-child,.matrix td:first-child,.matrix th:nth-child(2),.matrix td:nth-child(2){text-align:left}
  .matrix tbody tr:hover {background:#f8fafc}
  .matrix .model {font:11px ui-monospace,monospace; max-width:230px; overflow-wrap:anywhere; }
  .matrix .mark {display:inline-block; min-width:25px; padding:3px 5px; border-radius:4px; font-weight:650; text-decoration:none;}
  .matrix-wrap {overflow-x:auto; background:white; border:1px solid #e2e8f0; border-radius:8px;}
  .matrix .outcome {font-size:10px;display:inline-block;border-radius:4px;padding:3px 5px;white-space:nowrap;}
  .matrix .full-link {font-size:10px;color:#4338ca;text-decoration:underline;display:block;margin-top:3px;}
  @media(max-width:1050px){.matrix{min-width:1050px}}
</style>
<section class="mb-5">
  <h1 class="text-3xl font-bold tracking-tight">Private inference</h1>
  <p class="mt-2 text-slate-700">Attestation checks across providers and models. Open a result for its evidence and audit limitations.</p>
  <div class="mt-4 flex flex-wrap gap-5 text-sm border-b border-slate-200 pb-3">
    <span class="font-semibold">Overview</span>
    <a class="text-indigo-700 hover:underline" href="./history.html">Reference values over time</a>
    <a class="text-indigo-700 hover:underline" href="./evidence.html#routes">Provider audits &amp; routes</a>
  </div>
</section>
<p class="mb-3 text-xs text-slate-600"><span class="text-emerald-700">✓</span> check passed · <span class="text-rose-700">×</span> check rejected · <span class="text-amber-700">○</span> review pending · — not checked / not applicable. These are scoped adapter results, not full provider verdicts.</p>
<p class="mb-2 text-xs text-slate-500 lg:hidden">Scroll sideways for all check columns.</p>
<div class="matrix-wrap">
<table class="matrix">
  <thead><tr>
    <th scope="col">Provider</th><th scope="col">Model / endpoint</th><th scope="col">Attestation</th>
    {% for key in matrix_keys %}<th scope="col">{{ scorecard_labels[key] }}</th>{% endfor %}
    <th scope="col">Result</th>
  </tr></thead>
  <tbody>
  {% for row in rows %}
    <tr>
      <td class="font-semibold">{{ row.provider }}</td>
      <td class="model"><a class="text-indigo-700 hover:underline" href="./evidence.html#{{ row.evidence_id }}">{{ row.model }}</a></td>
      <td class="text-slate-500 text-xs">{{ row.attestation_type or '—' }}</td>
      {% for key in matrix_keys %}{% set cell = row.matrix_cells[key] %}
      <td><a class="mark {{ cell.css }}" href="./evidence.html#{{ row.evidence_id }}" title="{{ scorecard_labels[key] }}: {{ cell.meaning }}. Checked {{ row.checked_at or 'at unknown time' }}. Open full evidence." aria-label="{{ row.provider }} {{ row.model }}: {{ scorecard_labels[key] }} — {{ cell.meaning }}">{{ cell.mark }}</a></td>
      {% endfor %}
      <td><span class="outcome {{ row.outcome_css }}" title="{{ row.outcome_title }} {{ row.error or row.reason }}">{{ row.outcome_label }}</span><a class="full-link" href="./evidence.html#{{ row.evidence_id }}">All checks &amp; evidence</a></td>
    </tr>
  {% else %}<tr><td colspan="11">No adapter observations available.</td></tr>{% endfor %}
  </tbody>
</table>
</div>
<p class="mt-3 text-xs text-slate-500">{{ rows|length }} model / endpoint observations. This retains the original check columns; additional checks, including AMD hardware, TLS pinning, build provenance and runtime configuration, are in each row’s full evidence. An unavailable endpoint is not a rejected proof.</p>
{% if candidate_providers %}
<section class="mt-6 text-sm">
  <h2 class="font-semibold">Additional providers under review</h2>
  <p class="mt-1 text-slate-600">{{ candidate_providers|join(' · ') }}. Source and publication reviews only; no matched request observations. <a class="text-indigo-700 underline" href="./evidence.html#routes">Review coverage →</a></p>
</section>
{% endif %}
{% endblock %}
