{% extends "_base.html.j2" %}
{% block content %}
<style>
  .comparison { width:100%; border-collapse:collapse; font-size:13px; line-height:1.45; }
  .comparison th { text-align:left; padding:12px; background:#f1f5f9; color:#475569; }
  .comparison td { padding:12px; vertical-align:top; border-top:1px solid #e2e8f0; }
  .comparison tbody tr:hover { background:#f8fafc; }
  .comparison .provider { font-weight:650; display:block; }
  .comparison .path { display:block; margin-top:3px; color:#475569; }
  .comparison .result { display:block; font-size:11px; margin-top:5px; color:#64748b; }
  .comparison a { color:#4338ca; text-decoration:underline; text-underline-offset:3px; }
  .comparison-wrap { overflow-x:auto; background:white; border:1px solid #e2e8f0; border-radius:10px; }
  @media(max-width:800px) { .comparison { min-width:850px; } }
</style>
<section class="mb-5 max-w-4xl">
  <h1 class="text-3xl font-bold tracking-tight">Compare private inference</h1>
  <p class="mt-2 text-slate-700">Who can read a prompt, what references the client relies on, and what remains unproven. Different request paths get separate rows.</p>
  <p class="mt-2 text-sm text-slate-600">Client plaintext is implicit. Checks are scoped observations, not full provider verdicts. <a class="underline text-indigo-700" href="./methodology.html">Methodology</a></p>
</section>
<p class="mb-2 text-xs text-slate-500 md:hidden">Scroll the table sideways to see policy and evidence columns.</p>
<div id="comparison" class="comparison-wrap">
<table class="comparison">
  <thead><tr><th scope="col" style="width:19%">Provider / path</th><th scope="col" style="width:22%">Who can see plaintext?</th><th scope="col" style="width:23%">Reference policy</th><th scope="col">Main gap / evidence</th></tr></thead>
  <tbody>
  {% for route in route_cards %}
    {% set brief = route.comparison|default({}) %}
    <tr>
      <td><span class="provider">{{ brief.provider|default(route.provider) }}</span><span class="path">{{ brief.path|default(route.title) }}</span></td>
      <td>{{ brief.plaintext|default(route.plaintext_holders|join('; ')) }}</td>
      <td>{{ brief.policy|default(route.acceptance) }}</td>
      <td>{{ brief.gap|default(route.blockers|join('; ')) }}
        <span class="result">{% if route.matched_rows %}{{ route.matched_rows|map(attribute='outcome_label')|unique|join(' · ') }}{% else %}No matched request observation{% endif %}</span>
        <a href="./evidence.html#route-{{ route.id }}">Evidence →</a>
      </td>
    </tr>
  {% else %}<tr><td colspan="4">No route inventory available.</td></tr>{% endfor %}
  </tbody>
</table>
</div>
<p class="mt-3 text-xs text-slate-500">{{ route_cards|length }} paths · route inventory reviewed {{ routes_as_of or 'date unknown' }}. Observation times and individual checks are available in each evidence link.</p>
<section class="mt-7 border-t border-slate-200 pt-5 text-sm">
  <a class="font-semibold text-indigo-700 underline" href="./history.html">Reference values over time →</a>
  <p class="mt-1 text-slate-600">Explore new values, returning sets and gaps in the recorded history.</p>
</section>
{% endblock %}
